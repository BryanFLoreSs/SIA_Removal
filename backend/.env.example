APP_NAME=CityPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=citypulse
DB_USERNAME=postgres
DB_PASSWORD=replace-me

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=CityPulse
# SMTP settings used by PHPMailer to deliver email MFA codes.
PHPMAILER_HOST=smtp.gmail.com
PHPMAILER_PORT=587
PHPMAILER_USERNAME=replace-me
PHPMAILER_PASSWORD=replace-me
PHPMAILER_ENCRYPTION=tls
PHPMAILER_FROM_ADDRESS=hello@example.com
PHPMAILER_FROM_NAME=CityPulse
# Server-only Google Maps Platform Weather API key; never expose as NEXT_PUBLIC_
WEATHER_API_KEY=replace-me
