APP_NAME=CityPulse
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:replace-with-your-generated-laravel-key
APP_URL=https://citypulse-api.onrender.com

FRONTEND_URL=https://your-vercel-project.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@your-session-pooler-host:5432/postgres?sslmode=require
DB_SSLMODE=require

WEATHER_API_KEY=replace-me

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-smtp-email@gmail.com
MAIL_FROM_NAME=CityPulse

PHPMAILER_HOST=smtp.gmail.com
PHPMAILER_PORT=587
PHPMAILER_USERNAME=your-smtp-email@gmail.com
PHPMAILER_PASSWORD=your-gmail-app-password
PHPMAILER_ENCRYPTION=tls
PHPMAILER_TIMEOUT=8
PHPMAILER_FROM_ADDRESS=your-smtp-email@gmail.com
PHPMAILER_FROM_NAME=CityPulse
