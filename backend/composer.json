{
  "name": "citypulse/api",
  "type": "project",
  "description": "Laravel API starter for the CityPulse integration project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "phpmailer/phpmailer": "*"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true}
}
